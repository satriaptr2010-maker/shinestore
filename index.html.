      const obj = {
        id: existingId || ('p_' + Date.now()),
        code: document.getElementById('fAccCode').value.trim() || 'AKN-01',
        tab: document.getElementById('fAccTab').value,
        game: document.getElementById('fAccGame').value,
        title,
        price: Number(document.getElementById('fAccPrice').value) || 0,
        priceLabel: document.getElementById('fAccPriceLabel').value.trim() || '0',
        sold: document.getElementById('fAccSold').checked,
        highlights: document.getElementById('fAccHighlights').value.split(',').map(s => s.trim()).filter(Boolean),
