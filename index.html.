<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>SHINE STORE - Katalog Akun Game</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Rajdhani:wght@600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            gaming: ['Rajdhani', 'sans-serif'],
          },
          colors: {
            darkbg: '#0f0a19',
            cardbg: '#181126',
            surface: '#221836',
            bordercol: '#332450',
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --accent: #a855f7;
      --accent-2: #ec4899;
      --accent-glow: rgba(168, 85, 247, 0.35);
      --accent-soft: rgba(168, 85, 247, 0.16);
    }

    body {
      background-color: #0f0a19;
      color: #f3f4f6;
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .bg-accent { background-color: var(--accent); }
    .text-accent { color: var(--accent); }
    .border-accent { border-color: var(--accent); }
    .bg-accent-soft { background-color: var(--accent-soft); }
    .shadow-accent { box-shadow: 0 4px 20px var(--accent-glow); }

    .avatar-ring {
      background: linear-gradient(135deg, var(--accent-2), var(--accent), #6366f1);
    }

    .header-radial {
      background: radial-gradient(circle at 18% 0%, var(--accent-soft) 0%, rgba(15, 10, 25, 0) 65%);
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    .animate-float { animation: floatSlow 3s ease-in-out infinite; }

    @keyframes popIn {
      from { opacity: 0; transform: scale(0.96) translateY(6px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-pop { animation: popIn 0.2s ease-out forwards; }
  </style>
</head>
<body class="min-h-screen pb-24 selection:bg-purple-500 selection:text-white">

  <!-- Toast Notification Container -->
  <div id="toastBox" class="fixed top-4 left-1/2 -translate-x-1/2 z-[120] flex flex-col gap-2 pointer-events-none w-[92%] max-w-sm"></div>

  <!-- Main Container -->
  <div class="max-w-3xl mx-auto min-h-screen header-radial relative">

    <!-- 1. STORE HEADER -->
    <header class="px-4 pt-5 pb-3">
      <div class="flex items-center justify-between gap-3">
        <!-- Avatar & Store Info -->
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="relative shrink-0">
            <div class="w-16 h-16 sm:w-[72px] sm:h-[72px] rounded-full p-[2.5px] avatar-ring shadow-lg">
              <div class="w-full h-full rounded-full bg-[#0f0a19] p-[2px] overflow-hidden flex items-center justify-center">
                <img id="uiAvatar" src="" alt="Logo Toko" class="w-full h-full object-cover rounded-full" />
              </div>
            </div>
            <span class="absolute bottom-0.5 right-0.5 w-3.5 h-3.5 bg-emerald-400 border-2 border-[#0f0a19] rounded-full" title="Admin Online"></span>
          </div>

          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h1 id="uiStoreName" class="text-base sm:text-lg font-extrabold tracking-tight text-white truncate">TOUKA ENAY STR</h1>
              <!-- Blue Verified Check -->
              <svg id="uiVerifiedBadge" class="w-4 h-4 sm:w-5 sm:h-5 text-[#3897f0] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L14.8 4.2L18.3 3.9L19.6 7.2L22.6 9.1L21.9 12.6L23.5 15.8L20.9 18.2L20.5 21.7L17 22.3L14.5 24.8L11.3 23.3L7.8 24.1L5.8 21.2L2.3 20.6L2.4 17.1L0.2 14.3L2.2 11.4L1.9 7.9L5.2 6.5L6.9 3.4L10.4 4L12 2ZM10.3 16.5L17.2 9.6L15.8 8.2L10.3 13.7L7.9 11.3L6.5 12.7L10.3 16.5Z"/>
              </svg>
            </div>
            <p id="uiTagline1" class="text-xs sm:text-sm font-medium text-gray-200 truncate mt-0.5">Jual Beli Akun FF ML & Rental</p>
            <p id="uiTagline2" class="text-[11px] sm:text-xs text-gray-400 truncate mt-0.5">Pusat akun idaman, aman, dan murah</p>
          </div>
        </div>

        <!-- Right Action Buttons: Bookmark & Admin Password -->
        <div class="flex items-center gap-2 shrink-0">
          <button onclick="openBookmarksModal()" title="Akun Tersimpan" class="relative w-10 h-10 rounded-full bg-surface/90 border border-bordercol hover:border-accent flex items-center justify-center text-gray-200 transition active:scale-95">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            <span id="uiBookmarkBadge" class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-pink-500 text-white text-[10px] font-bold flex items-center justify-center">0</span>
          </button>

          <button onclick="handleAdminAccessClick()" class="h-10 px-3.5 rounded-full bg-surface/90 border border-accent/60 hover:bg-accent text-white flex items-center gap-1.5 text-xs font-extrabold transition shadow-accent active:scale-95">
            <svg id="adminLockIcon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span id="adminBtnLabel">Admin</span>
          </button>
        </div>
      </div>
    </header>

    <!-- 2. BANNER SLIDER -->
    <section class="px-4 mt-1">
      <div class="relative rounded-2xl overflow-hidden border border-bordercol bg-cardbg shadow-xl group">
        <div id="uiBannerSlide" class="relative w-full aspect-[21/9] sm:aspect-[24/9] overflow-hidden"></div>

        <!-- Prev / Next Arrows -->
        <button onclick="prevBanner()" class="hidden sm:flex absolute left-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/50 hover:bg-black/80 text-white items-center justify-center opacity-0 group-hover:opacity-100 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button onclick="nextBanner()" class="hidden sm:flex absolute right-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/50 hover:bg-black/80 text-white items-center justify-center opacity-0 group-hover:opacity-100 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>

        <!-- Bottom Bar -->
        <div class="bg-[#19112b]/95 backdrop-blur-md px-3 py-1.5 flex items-center justify-between border-t border-white/10 text-[10px] sm:text-xs">
          <div class="flex items-center gap-1.5 truncate max-w-[38%]">
            <span class="text-purple-400">🌐</span>
            <a id="uiBannerLeftLink" href="#" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white font-medium truncate">www.toukatopup.id</a>
          </div>
          <div id="uiBannerDots" class="flex items-center gap-1.5 shrink-0"></div>
          <div class="flex items-center gap-1.5 truncate max-w-[38%] justify-end">
            <span class="text-pink-400">🛒</span>
            <a id="uiBannerRightLink" href="#" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white font-medium truncate">www.toukaenay.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. QUICK ACTIONS ROW (6 Circular Menu Buttons) -->
    <section class="mt-4 px-4">
      <div id="uiQuickActions" class="flex items-start gap-3.5 sm:gap-5 overflow-x-auto no-scrollbar pb-1 justify-between sm:justify-around"></div>
    </section>

    <!-- 4. MAIN NAVIGATION TABS (Stok, Rental, Gift) -->
    <section class="mt-4 border-b border-bordercol px-4">
      <div class="flex items-center justify-around">
        <button onclick="setMainTab('Stok')" id="tabBtn-Stok" class="main-tab flex-1 py-3 flex items-center justify-center gap-2 text-sm font-bold border-b-[3px] border-accent text-white transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span>Stok</span>
        </button>
        <button onclick="setMainTab('Rental')" id="tabBtn-Rental" class="main-tab flex-1 py-3 flex items-center justify-center gap-2 text-sm font-semibold border-b-[3px] border-transparent text-gray-400 hover:text-gray-200 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
          <span>Rental</span>
        </button>
        <button onclick="setMainTab('Gift')" id="tabBtn-Gift" class="main-tab flex-1 py-3 flex items-center justify-center gap-2 text-sm font-semibold border-b-[3px] border-transparent text-gray-400 hover:text-gray-200 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
          <span>Gift</span>
        </button>
      </div>
    </section>

    <!-- 5. SEARCH, GAME FILTER & SORT -->
    <section class="px-4 pt-3.5">
      <div class="relative">
        <span class="absolute inset-y-0 left-3.5 flex items-center text-gray-400 pointer-events-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </span>
        <input
          type="text"
          id="uiSearchInput"
          oninput="handleSearch(this.value)"
          placeholder="Cari akun, game, skin, harga..."
          class="w-full bg-cardbg border border-bordercol focus:border-accent rounded-2xl py-2.5 pl-10 pr-9 text-sm text-white placeholder-gray-400 outline-none transition"
        />
        <button id="uiClearSearch" onclick="clearSearch()" class="hidden absolute inset-y-0 right-3 items-center text-gray-400 hover:text-white">✕</button>
      </div>

      <!-- Horizontal Game Pills -->
      <div id="uiGamePills" class="flex items-center gap-2 overflow-x-auto no-scrollbar mt-3.5 pb-1"></div>

      <!-- Results Count & Sort/Filter -->
      <div class="flex items-center justify-between mt-3 mb-3">
        <span id="uiResultCount" class="text-xs sm:text-sm font-medium text-gray-400">0 hasil</span>
        <button onclick="openModal('filterModal')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface border border-bordercol hover:border-accent text-xs font-semibold text-gray-200 transition active:scale-95">
          <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110 4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110 4m0 4v2m0-6V4"/></svg>
          <span>Filter</span>
          <span id="uiFilterDot" class="hidden w-2 h-2 rounded-full bg-pink-500"></span>
        </button>
      </div>
    </section>

    <!-- 6. ACCOUNT CATALOG GRID -->
    <main class="px-4">
      <div id="uiCatalogGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-3.5"></div>

      <div id="uiEmptyCatalog" class="hidden py-14 text-center">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-surface border border-bordercol flex items-center justify-center text-3xl mb-3">🎮</div>
        <h3 class="text-base font-bold text-white">Akun tidak ditemukan</h3>
        <p class="text-xs text-gray-400 mt-1 max-w-xs mx-auto">Coba ubah kata kunci pencarian, kategori game, atau reset filter.</p>
        <button onclick="resetAllFilters()" class="mt-4 px-4 py-2 rounded-xl bg-accent text-white text-xs font-bold shadow-accent">Reset Filter</button>
      </div>
    </main>

    <!-- FLOATING EVENT UNDIAN MASCOT (Pojok Kanan Bawah) -->
    <div id="uiEventFloating" onclick="openEventModal()" class="fixed right-3 bottom-5 z-30 flex flex-col items-center cursor-pointer animate-float select-none">
      <div class="relative">
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white shadow-lg border-2 border-purple-400 flex items-center justify-center overflow-hidden p-1">
          <svg viewBox="0 0 64 64" class="w-full h-full">
            <polygon points="10,24 14,6 28,18" fill="#ffffff" stroke="#2d1b4e" stroke-width="3" stroke-linejoin="round"/>
            <polygon points="54,24 50,6 36,18" fill="#ffffff" stroke="#2d1b4e" stroke-width="3" stroke-linejoin="round"/>
            <polygon points="14,21 16,11 24,18" fill="#f472b6"/>
            <polygon points="50,21 48,11 40,18" fill="#f472b6"/>
            <ellipse cx="32" cy="36" rx="22" ry="19" fill="#ffffff" stroke="#2d1b4e" stroke-width="3"/>
            <circle cx="24" cy="34" r="3" fill="#1e1b4b"/>
            <circle cx="40" cy="34" r="3" fill="#1e1b4b"/>
            <circle cx="25" cy="33" r="1" fill="#ffffff"/>
            <circle cx="41" cy="33" r="1" fill="#ffffff"/>
            <ellipse cx="18" cy="39" rx="3.5" ry="2" fill="#fda4af"/>
            <ellipse cx="46" cy="39" rx="3.5" ry="2" fill="#fda4af"/>
            <path d="M29 40 Q32 43 35 40" fill="none" stroke="#2d1b4e" stroke-width="2.2" stroke-linecap="round"/>
            <rect x="36" y="42" width="18" height="11" rx="2" transform="rotate(-12 36 42)" fill="#fbbf24" stroke="#92400e" stroke-width="1.5"/>
          </svg>
        </div>
        <span class="absolute -top-1 -left-1 w-3.5 h-3.5 bg-red-500 rounded-full border border-white animate-ping"></span>
        <span class="absolute -top-1 -left-1 w-3.5 h-3.5 bg-red-500 rounded-full border border-white"></span>
      </div>
      <span id="uiEventLabel" class="mt-1 px-2 py-0.5 rounded-full bg-cardbg/95 border border-purple-500/50 text-[10px] font-extrabold text-white shadow-md">EventUndian</span>
    </div>

    <!-- FOOTER -->
    <footer class="mt-12 px-4 text-center text-xs text-gray-500 pb-6">
      <p id="uiFooterText">© 2026 TOUKA ENAY STR. Pusat Akun Game Terpercaya.</p>
      <p class="mt-1 text-[11px] text-gray-600">Klik tombol <span class="text-purple-400 font-semibold">Admin</span> di kanan atas untuk mengelola seluruh toko.</p>
    </footer>
  </div>

  <!-- ===================================================================== -->
  <!-- MODALS                                                                -->
  <!-- ===================================================================== -->

  <!-- A. SUPABASE ADMIN LOGIN MODAL -->
  <div id="passwordLoginModal" class="hidden fixed inset-0 z-[70] bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-[#181126] border border-bordercol w-full max-w-sm rounded-3xl p-5 sm:p-6 modal-pop shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-bordercol pb-3">
        <div class="flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-accent-soft text-accent flex items-center justify-center font-bold text-base">🔐</span>
          <div>
            <h3 class="text-base font-extrabold text-white">Login Admin</h3>
            <p class="text-[11px] text-gray-400">Masuk menggunakan akun Supabase admin</p>
          </div>
        </div>
        <button onclick="closeModal('passwordLoginModal')" class="w-8 h-8 rounded-full bg-surface text-gray-300 hover:text-white">✕</button>
      </div>
      <div class="space-y-3">
        <div>
          <label class="text-xs font-bold text-gray-300 block mb-1.5">Email Admin</label>
          <input type="email" id="adminEmailInput" autocomplete="username" placeholder="Email admin" onkeydown="if(event.key==='Enter') document.getElementById('adminPasswordInput').focus()" class="w-full bg-[#0f0a19] border-2 border-bordercol focus:border-accent rounded-2xl py-3 px-4 text-sm font-semibold text-white outline-none transition" />
        </div>
        <div>
          <label class="text-xs font-bold text-gray-300 block mb-1.5">Password</label>
          <div class="relative">
            <input type="password" id="adminPasswordInput" autocomplete="current-password" placeholder="Password akun Supabase" onkeydown="if(event.key==='Enter') verifyAdminPassword()" class="w-full bg-[#0f0a19] border-2 border-bordercol focus:border-accent rounded-2xl py-3 pl-4 pr-12 text-sm font-semibold text-white outline-none transition" />
            <button type="button" onclick="togglePasswordVisibility('adminPasswordInput', this)" title="Tampilkan / Sembunyikan Password" class="absolute inset-y-0 right-3 px-2 text-gray-400 hover:text-white">👁️</button>
          </div>
          <p id="passwordErrorMsg" class="hidden text-[11px] text-red-400 font-semibold mt-1.5">Login gagal. Periksa email dan password.</p>
        </div>
        <button id="adminLoginButton" onclick="verifyAdminPassword()" class="w-full py-3 rounded-2xl bg-accent hover:opacity-95 text-white text-xs sm:text-sm font-extrabold shadow-accent transition active:scale-98">🔓 Masuk ke Panel Admin</button>
      </div>
    </div>
  </div>

  <!-- B. FULL ADMIN PANEL MODAL (5 TABS) -->
  <div id="adminPanelModal" class="hidden fixed inset-0 z-[80] bg-black/90 backdrop-blur-md flex items-center justify-center p-0 sm:p-4">
    <div class="bg-[#140e21] border border-bordercol w-full max-w-4xl h-full sm:h-[92vh] sm:rounded-3xl flex flex-col overflow-hidden modal-pop shadow-2xl">
      <!-- Header -->
      <div class="px-4 sm:px-6 py-3.5 bg-[#1d1430] border-b border-bordercol flex items-center justify-between gap-2 shrink-0">
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-emerald-500 text-[10px] font-black uppercase text-white">ADMIN AKTIF</span>
            <h2 class="text-sm sm:text-lg font-extrabold text-white truncate">Panel Admin Toko</h2>
          </div>
          <p class="text-[11px] text-gray-400 truncate">Semua perubahan langsung tersimpan & tampil di katalog</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button onclick="logoutAdminSession()" class="px-3 py-2 rounded-xl bg-red-500/20 hover:bg-red-600 text-red-300 hover:text-white text-xs font-bold transition">
            Keluar
          </button>
          <button onclick="closeModal('adminPanelModal')" class="px-3.5 py-2 rounded-xl bg-accent text-white text-xs font-extrabold shadow-accent transition">
            Lihat Toko
          </button>
        </div>
      </div>

      <!-- 5 Admin Navigation Tabs -->
      <div class="flex items-center gap-1.5 px-4 py-2.5 bg-[#100b1b] border-b border-bordercol overflow-x-auto no-scrollbar shrink-0">
        <button onclick="switchAdminTab('accounts')" id="admTab-accounts" class="adm-nav px-3.5 py-2 rounded-xl text-xs font-bold bg-accent text-white shrink-0">📦 1. Kelola Akun</button>
        <button onclick="switchAdminTab('profile')" id="admTab-profile" class="adm-nav px-3.5 py-2 rounded-xl text-xs font-bold bg-surface text-gray-300 shrink-0">🏪 2. Profil & Tema</button>
        <button onclick="switchAdminTab('banners')" id="admTab-banners" class="adm-nav px-3.5 py-2 rounded-xl text-xs font-bold bg-surface text-gray-300 shrink-0">🖼️ 3. Banner & Menu</button>
        <button onclick="switchAdminTab('testi')" id="admTab-testi" class="adm-nav px-3.5 py-2 rounded-xl text-xs font-bold bg-surface text-gray-300 shrink-0">📸 4. Testimoni PNG & Event</button>
        <button onclick="switchAdminTab('games')" id="admTab-games" class="adm-nav px-3.5 py-2 rounded-xl text-xs font-bold bg-surface text-gray-300 shrink-0">🎮 5. Game & Backup</button>
      </div>

      <!-- Admin Body Container -->
      <div id="adminBodyContainer" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6"></div>
    </div>
  </div>

  <!-- C. PRODUCT DETAIL MODAL -->
  <div id="productDetailModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-[#181126] border border-bordercol w-full max-w-lg rounded-t-3xl sm:rounded-3xl max-h-[92vh] flex flex-col overflow-hidden modal-pop shadow-2xl">
      <div class="px-4 py-3.5 border-b border-bordercol flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <span id="detGame" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-accent-soft text-accent border border-accent/30">Mobile Legends</span>
          <span id="detTab" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-pink-500/20 text-pink-300 border border-pink-500/30">Stok</span>
        </div>
        <button onclick="closeModal('productDetailModal')" class="w-8 h-8 rounded-full bg-surface text-gray-300 hover:text-white">✕</button>
      </div>

      <div class="overflow-y-auto p-4 space-y-4">
        <div class="relative rounded-2xl overflow-hidden border border-bordercol bg-black">
