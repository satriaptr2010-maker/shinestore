    function renderBanners() {
      const banners = config.banners || [];
      const slideBox = document.getElementById('uiBannerSlide');
      const dotsBox = document.getElementById('uiBannerDots');

      const bf = config.bannerFooter || {};
      const leftLink = document.getElementById('uiBannerLeftLink');
      const rightLink = document.getElementById('uiBannerRightLink');
      leftLink.textContent = bf.left || 'www.toukatopup.id';
      leftLink.href = bf.leftUrl || '#';
      rightLink.textContent = bf.right || 'www.toukaenay.com';
      rightLink.href = bf.rightUrl || '#';

      if (!banners.length) {
        slideBox.innerHTML = `<div class="w-full h-full flex items-center justify-center text-xs text-gray-400">Belum ada banner promo.</div>`;
        dotsBox.innerHTML = '';
        return;
      }

      if (appState.bannerIdx >= banners.length) appState.bannerIdx = 0;
      const b = banners[appState.bannerIdx];

      slideBox.innerHTML = `
        <a href="${b.link || '#'}" ${b.link && b.link.startsWith('http') ? 'target="_blank" rel="noopener noreferrer"' : ''} class="block w-full h-full relative">
          <img src="${b.image}" alt="${b.title}" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#120826]/90 via-[#1f0e40]/65 to-transparent flex flex-col justify-center px-4 sm:px-7">
            ${b.badge ? `<span class="w-fit px-2 py-0.5 rounded bg-pink-500 text-white text-[9px] sm:text-[10px] font-black uppercase tracking-wider mb-1">${b.badge}</span>` : ''}
            <h2 class="font-gaming text-lg sm:text-3xl font-extrabold text-white uppercase leading-tight max-w-[82%] drop-shadow">${b.title}</h2>
            ${b.subtitle ? `<span class="mt-1.5 w-fit px-2.5 py-0.5 rounded-full bg-purple-600/90 border border-purple-300/40 text-[9px] sm:text-[11px] font-bold text-white">${b.subtitle}</span>` : ''}
          </div>
        </a>
      `;

      dotsBox.innerHTML = banners.map((_, i) => `
        <button onclick="goBanner(${i})" class="h-1.5 rounded-full transition-all ${i === appState.bannerIdx ? 'w-4 bg-accent' : 'w-1.5 bg-gray-500'}"></button>
      `).join('');
    }

    function nextBanner() {
      if (!config.banners.length) return;
      appState.bannerIdx = (appState.bannerIdx + 1) % config.banners.length;
      renderBanners();
    }
    function prevBanner() {
      if (!config.banners.length) return;
      appState.bannerIdx = (appState.bannerIdx - 1 + config.banners.length) % config.banners.length;
      renderBanners();
    }
    function goBanner(i) {
      appState.bannerIdx = i;
      renderBanners();
    }

