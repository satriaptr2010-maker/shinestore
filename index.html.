    // =========================================================================
    // 3. TESTIMONIAL PNG CANVAS RENDERER & GALLERY
    // =========================================================================
    function renderTestimonialPng(testi, callback) {
      const canvas = document.createElement('canvas');
      const W = 720;
      const H = 880;
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext('2d');

      const theme = THEME_PALETTES[config.profile.theme] || THEME_PALETTES.purple;
      const storeName = (config.profile.name || 'TOUKA ENAY STR').toUpperCase();

      function roundRect(x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }

      function drawWrapped(text, x, y, maxW, lineH, maxLines) {
        const words = (text || '').split(/\s+/);
        let line = '';
        let count = 0;
        for (let i = 0; i < words.length; i++) {
          const test = line + words[i] + ' ';
          if (ctx.measureText(test).width > maxW && i > 0) {
            ctx.fillText(line.trim(), x, y);
            line = words[i] + ' ';
            y += lineH;
            count++;
            if (count >= maxLines - 1) break;
          } else {
            line = test;
          }
        }
        ctx.fillText(line.trim(), x, y);
      }

      const paint = (proofImg = null) => {
        const bg = ctx.createLinearGradient(0, 0, W, H);
        bg.addColorStop(0, '#130b24');
        bg.addColorStop(0.5, '#1d1136');
        bg.addColorStop(1, '#0d0817');
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, W, H);

        ctx.strokeStyle = 'rgba(255,255,255,0.16)';
        ctx.lineWidth = 4;
        roundRect(24, 24, W - 48, H - 48, 34);
        ctx.stroke();

        ctx.fillStyle = 'rgba(255,255,255,0.06)';
        roundRect(48, 48, W - 96, 88, 22);
        ctx.fill();

        ctx.fillStyle = theme.accent;
        ctx.beginPath();
        ctx.arc(96, 92, 28, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = '900 26px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(storeName.charAt(0), 96, 101);

        ctx.textAlign = 'left';
        ctx.fillStyle = '#ffffff';
        ctx.font = '800 22px Inter, sans-serif';
        ctx.fillText(storeName, 140, 88);
        ctx.fillStyle = '#c4b5fd';
        ctx.font = '600 15px Inter, sans-serif';
        ctx.fillText('BUKTI TESTIMONI & TRANSAKSI RESMI', 140, 113);

        ctx.fillStyle = '#10b981';
        roundRect(W - 190, 72, 122, 40, 20);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = '800 14px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('✔ VERIFIED', W - 129, 97);

        ctx.textAlign = 'left';
        ctx.fillStyle = 'rgba(15, 10, 25, 0.85)';
        roundRect(48, 156, W - 96, 168, 22);
        ctx.fill();
        ctx.strokeStyle = theme.accent;
        ctx.lineWidth = 2;
        roundRect(48, 156, W - 96, 168, 22);
        ctx.stroke();

        ctx.fillStyle = '#f472b6';
        ctx.font = '800 15px Inter, sans-serif';
        ctx.fillText(`⚡ ${testi.status || 'DONE • AMANAH 100%'}`, 72, 192);

        ctx.textAlign = 'right';
        ctx.fillStyle = '#9ca3af';
        ctx.font = '600 15px Inter, sans-serif';
        ctx.fillText(testi.date || 'Hari ini', W - 72, 192);

        ctx.textAlign = 'left';
        ctx.fillStyle = '#9ca3af';
        ctx.font = '600 15px Inter, sans-serif';
        ctx.fillText('Pembeli:', 72, 234);
        ctx.fillStyle = '#ffffff';
        ctx.font = '800 19px Inter, sans-serif';
        ctx.fillText(testi.buyer || 'Buyer', 155, 234);

        ctx.fillStyle = '#9ca3af';
        ctx.font = '600 15px Inter, sans-serif';
        ctx.fillText('Game/Item:', 72, 268);
        ctx.fillStyle = '#e9d5ff';
        ctx.font = '700 18px Inter, sans-serif';
        ctx.fillText((testi.item || 'Akun Game').slice(0, 36), 175, 268);

        ctx.fillStyle = '#9ca3af';
        ctx.font = '600 15px Inter, sans-serif';
        ctx.fillText('Nominal:', 72, 302);
        ctx.fillStyle = '#34d399';
        ctx.font = '900 20px Inter, sans-serif';
        ctx.fillText(testi.price || 'LUNAS', 155, 302);

        if (proofImg) {
          ctx.fillStyle = '#08050e';
          roundRect(48, 344, W - 96, 360, 22);
          ctx.fill();
          ctx.save();
          roundRect(48, 344, W - 96, 360, 22);
          ctx.clip();
          const scale = Math.min((W - 96) / proofImg.width, 360 / proofImg.height);
          const dw = proofImg.width * scale;
          const dh = proofImg.height * scale;
          ctx.drawImage(proofImg, 48 + ((W - 96) - dw) / 2, 344 + (360 - dh) / 2, dw, dh);
          ctx.restore();

          ctx.fillStyle = 'rgba(255,255,255,0.07)';
          roundRect(48, 720, W - 96, 76, 18);
          ctx.fill();
          ctx.fillStyle = '#f3f4f6';
          ctx.font = 'italic 600 17px Inter, sans-serif';
          drawWrapped(`"${testi.comment || 'Terima kasih sudah order!'}"`, 68, 750, W - 136, 24, 2);
        } else {
          ctx.fillStyle = '#0b141a';
          roundRect(48, 344, W - 96, 448, 22);
          ctx.fill();

          ctx.fillStyle = '#1f2c34';
          roundRect(48, 344, W - 96, 60, 22);
          ctx.fill();
          ctx.fillStyle = '#00a884';
          ctx.beginPath();
          ctx.arc(86, 374, 17, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#ffffff';
          ctx.font = '800 16px Inter, sans-serif';
          ctx.fillText(testi.buyer || 'Buyer', 114, 372);
          ctx.fillStyle = '#8696a0';
          ctx.font = '500 13px Inter, sans-serif';
          ctx.fillText('Bukti Chat & Testimoni Pembeli', 114, 390);

          ctx.fillStyle = '#202c33';
          roundRect(72, 426, W - 180, 170, 18);
          ctx.fill();
          ctx.fillStyle = '#34d399';
          ctx.font = '700 15px Inter, sans-serif';
          ctx.fillText(`~ ${testi.buyer || 'Buyer'}`, 92, 454);
          ctx.fillStyle = '#e9edef';
          ctx.font = '500 19px Inter, sans-serif';
          drawWrapped(testi.comment || 'Akun sudah masuk min, amanah banget!', 92, 486, W - 220, 27, 4);

          ctx.fillStyle = '#005c4b';
          roundRect(160, 620, W - 232, 130, 18);
          ctx.fill();
          ctx.fillStyle = '#6ee7b7';
          ctx.font = '700 15px Inter, sans-serif';
          ctx.fillText(`Admin ${storeName}`, 182, 648);
          ctx.fillStyle = '#ffffff';
          ctx.font = '500 18px Inter, sans-serif';
          drawWrapped('Siap kak, terima kasih banyak sudah order di toko kami! Ditunggu next ordernya 🙏🔥', 182, 678, W - 270, 26, 3);
        }

        ctx.textAlign = 'center';
        ctx.fillStyle = '#9ca3af';
        ctx.font = '700 15px Inter, sans-serif';
        ctx.fillText(`OFFICIAL PROOF • ${storeName} • TERPERCAYA 100%`, W / 2, H - 45);

        callback(canvas.toDataURL('image/png'));
      };

      if (testi.proofImage) {
        const img = new Image();
        img.onload = () => paint(img);
        img.onerror = () => paint(null);
        img.src = testi.proofImage;
      } else {
        paint(null);
      }
    }

