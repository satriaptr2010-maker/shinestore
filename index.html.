    function renderCatalog() {
      const grid = document.getElementById('uiCatalogGrid');
      const empty = document.getElementById('uiEmptyCatalog');

      let items = (config.products || []).filter(p => {
        if (p.tab !== appState.mainTab) return false;
        if (appState.gameFilter !== 'Semua' && p.game !== appState.gameFilter) return false;
        if (appState.statusFilter === 'ready' && p.sold) return false;
        if (appState.statusFilter === 'sold' && !p.sold) return false;
        if (appState.search) {
          const text = `${p.title} ${p.game} ${p.specs} ${p.priceLabel} ${p.code} ${(p.highlights || []).join(' ')}`.toLowerCase();
          if (!text.includes(appState.search)) return false;
        }
        return true;
      });

      if (appState.sort === 'low') items.sort((a, b) => a.price - b.price);
      if (appState.sort === 'high') items.sort((a, b) => b.price - a.price);

      document.getElementById('uiResultCount').textContent = `${items.length} hasil`;

      if (!items.length) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      grid.innerHTML = items.map(item => {
        const saved = bookmarks.includes(item.id);
        return `
          <article onclick="openProductDetail('${item.id}')" class="group rounded-2xl overflow-hidden bg-cardbg border border-bordercol hover:border-accent transition cursor-pointer flex flex-col shadow-lg">
            <div class="relative aspect-[4/5] w-full overflow-hidden bg-[#1e1233]">
              <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
              <div class="absolute top-2 left-2 right-2 flex items-center justify-between gap-1">
                <span class="px-2 py-0.5 rounded-md bg-black/75 text-[10px] font-bold text-white border border-white/15 truncate">${item.game}</span>
                <span class="px-1.5 py-0.5 rounded-md ${item.sold ? 'bg-red-600 text-white' : 'bg-emerald-500/90 text-white'} text-[9px] font-black uppercase shrink-0">${item.sold ? 'SOLD OUT' : 'READY'}</span>
              </div>
              ${item.sold ? `
                <div class="absolute inset-0 bg-black/65 flex items-center justify-center pointer-events-none">
                  <span class="px-3 py-1 rounded-lg bg-red-600 text-white font-black text-xs tracking-wider uppercase -rotate-6 border border-white">SOLD OUT</span>
                </div>
              ` : ''}
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/95 via-black/70 to-transparent pt-8 pb-2.5 px-2.5 flex items-end justify-between gap-1">
                <div class="min-w-0">
                  <span class="text-[9px] uppercase tracking-wider text-pink-300 font-bold block leading-none mb-1">HARGA</span>
                  <div class="inline-block px-2 py-0.5 rounded-md bg-pink-500 text-white font-gaming font-extrabold text-sm leading-none shadow">${item.priceLabel}</div>
                </div>
                <button onclick="event.stopPropagation(); toggleBookmark('${item.id}')" title="Simpan Akun" class="w-8 h-8 rounded-full ${saved ? 'bg-pink-500 text-white' : 'bg-black/65 text-gray-200'} border border-white/20 flex items-center justify-center shrink-0 transition">
                  <svg class="w-4 h-4" fill="${saved ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                </button>
              </div>
            </div>
            <div class="p-2.5 flex-1 flex flex-col justify-between">
              <h3 class="text-xs font-bold text-gray-100 line-clamp-2 leading-snug group-hover:text-accent transition">${item.title}</h3>
              <div class="flex items-center gap-1 mt-2 flex-wrap">
                ${(item.highlights || []).slice(0, 2).map(h => `<span class="px-1.5 py-0.5 rounded bg-surface text-[10px] text-gray-300 truncate max-w-[48%]">${h}</span>`).join('')}
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function openProductDetail(id) {
      const item = config.products.find(p => p.id === id);
      if (!item) return;
      appState.activeProductId = id;

      document.getElementById('detGame').textContent = item.game;
      document.getElementById('detTab').textContent = item.tab;
      document.getElementById('detImg').src = item.image;
      document.getElementById('detTitle').textContent = item.title;
      document.getElementById('detCode').textContent = `Kode: #${item.code || item.id} • Status: ${item.sold ? 'Sold Out' : 'Ready'}`;
      document.getElementById('detPrice').textContent = `Rp ${item.priceLabel}`;
      document.getElementById('detSpecs').textContent = item.specs || '-';

      const soldBadge = document.getElementById('detSoldBadge');
      if (item.sold) soldBadge.classList.remove('hidden');
      else soldBadge.classList.add('hidden');

      document.getElementById('detHighlights').innerHTML = (item.highlights || []).map(h => `
        <div class="bg-surface border border-bordercol rounded-xl p-2 text-center">
          <span class="text-[11px] font-bold text-white block truncate">${h}</span>
        </div>
      `).join('');

      const wa = (config.profile.whatsapp || '6281234567890').replace(/[^0-9]/g, '');
      const text = encodeURIComponent(`Halo Admin ${config.profile.name}, saya tertarik dengan produk:\n• ${item.title}\n• Game: ${item.game}\n• Kode: #${item.code}\n• Harga: Rp ${item.priceLabel}`);
      document.getElementById('detWaLink').href = `https://wa.me/${wa}?text=${text}`;
      document.getElementById('detWaBtnText').textContent = item.sold ? 'Tanya Stok Serupa via WA' : 'Beli via WhatsApp';

      updateDetailBookmarkUI();
